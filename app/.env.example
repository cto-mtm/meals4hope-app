# Local dev points at the offline Firebase Emulator Suite (demo- project id =
# fully offline, no login, no real project needed).
VITE_API_URL=http://127.0.0.1:5001/demo-meals4hope/us-central1/api
VITE_USE_EMULATORS=true

# Production Firebase web config (from Firebase console → Project settings).
# Only needed for production builds — local dev ignores these.
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_ME.appspot.com
VITE_FIREBASE_APP_ID=REPLACE_ME
