rules_version = '2';

// Attachments (receipt photos, certificates, flyers). Images + PDF only,
// max 15 MB. Access requires an ACTIVE M4H MEMBER — plain "signed in" is
// not enough because anyone can mint a token for this project with the
// public web config (e.g. their own Google account). Cross-service rules
// check the caller's users/{uid} doc in Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function isActiveMember() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.activo == true;
    }

    match /attachments/{allPaths=**} {
      allow read: if isActiveMember();
      allow write: if isActiveMember()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }
  }
}
