rules_version = '2';

// Internal tool: only authenticated, ACTIVE M4H members touch data.
// Admin-only areas: users and catalogs (areas, lineas).
// User provisioning happens via the Cloud Functions API (Admin SDK),
// so clients never create users/{uid} docs directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveMember() {
      return signedIn() && me().activo == true;
    }

    function isAdmin() {
      return signedIn() && me().activo == true && me().role == 'admin';
    }

    // Users: own doc always readable (the login flow checks membership by
    // reading it); the rest of the roster only for active members. A random
    // Google account CAN get a valid token for this project (public config),
    // so "signed in" must never be enough to read member names/emails.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isActiveMember());
      allow write: if false;
    }

    // Admin-editable catalogs
    match /areas/{id} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }
    match /lineas/{id} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    // Core entities — full CRUD for active members. Deletes are soft
    // (deletedAt field), so hard delete is blocked everywhere.
    match /entradas/{id} {
      allow read, create, update: if isActiveMember();
      allow delete: if false;
    }
    match /salidas/{id} {
      allow read, create, update: if isActiveMember();
      allow delete: if false;
    }
    match /facturas/{id} {
      allow read, create, update: if isActiveMember();
      allow delete: if false;
    }
    match /attachments/{id} {
      allow read, create, update: if isActiveMember();
      allow delete: if false;
    }
    match /organizations/{id} {
      allow read, create, update: if isActiveMember();
      allow delete: if false;
    }
    match /contacts/{id} {
      allow read, create, update: if isActiveMember();
      allow delete: if false;
    }
    // M4H team members as data (the "Contacto M4H" of iniciativas) —
    // decoupled from login accounts (users collection).
    match /teamMembers/{id} {
      allow read, create, update: if isActiveMember();
      allow delete: if false;
    }

    // Audit log: append-only, immutable, and entries can only be written
    // in the author's own name (no spoofing another member's userId).
    match /auditLogs/{id} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
